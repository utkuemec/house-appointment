# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for admin operations (seeding, migrations)
# Keep this secret - never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Service (Resend)
# Optional - app works without it but emails won't send
# Sign up at: https://resend.com
RESEND_API_KEY=re_your_api_key

# RECO Verification Service (Browserless.io)
# Optional - for automatic realtor license verification
# Sign up at: https://browserless.io
BROWSERLESS_API_KEY=your-browserless-key

# Cron Job Security (Vercel)
# Set this in Vercel to secure cron endpoints
CRON_SECRET=your-secret-for-cron-auth
